# https://wiki.mozilla.org/Security/Guidelines/OpenSSH

_sshd_set_option() {
  local key="$1"
  local value="$2"
  local conf="$3"

  if ! grep -q "^${key}" "$conf" 2> /dev/null; then
    echo "${key} ${value}" >> "$conf"
  else
    sed -i "s/${key}.*/${key} ${value}/" "$conf"
  fi
}

function f_sshdconfig {
  echo "[$SCRIPT_COUNT] $SSHDFILE"

  local SSHD_BACKUP
  SSHD_BACKUP="$(mktemp --tmpdir sshd_config.XXXXX)"
  cp "$SSHDFILE" "$SSHD_BACKUP"

  awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.tmp
  if [ -s /etc/ssh/moduli.tmp ]; then
    mv /etc/ssh/moduli.tmp /etc/ssh/moduli
  else
    rm -f /etc/ssh/moduli.tmp
    echo "Warning: no moduli with sufficient bit length found, keeping original."
  fi

  if grep -q '^Include' /etc/ssh/sshd_config; then
    local INCLUDEDIR
    # shellcheck disable=SC2046
    INCLUDEDIR="$(dirname $(grep '^Include' /etc/ssh/sshd_config | awk '{print $NF}'))"

    if [ ! -d "$INCLUDEDIR" ]; then
      mkdir -p "$INCLUDEDIR"
    fi

    SSHDCONF="$INCLUDEDIR/hardening.conf"

    cp "$SSHDFILE" "$SSHDCONF"

    sed -i '/.*Subsystem.*/d' "$SSHDFILE"
    sed -i '/Include.*/d' "$SSHDCONF"
  else
    SSHDCONF="$SSHDFILE"
  fi

  if [[ $VERBOSE == "Y" ]]; then
    echo "Using $SSHDCONF"
  fi

  sed -i '/HostKey.*ssh_host_dsa_key.*/d' "$SSHDCONF"
  sed -i '/KeyRegenerationInterval.*/d' "$SSHDCONF"
  sed -i '/ServerKeyBits.*/d' "$SSHDCONF"
  sed -i '/UseLogin.*/d' "$SSHDCONF"

  sed -i 's/.*X11Forwarding.*/X11Forwarding no/' "$SSHDCONF"
  sed -i 's/.*LoginGraceTime.*/LoginGraceTime 20/' "$SSHDCONF"
  sed -i 's/.*PermitRootLogin.*/PermitRootLogin no/' "$SSHDCONF"
  sed -i 's/.*UsePrivilegeSeparation.*/UsePrivilegeSeparation sandbox/' "$SSHDCONF"
  sed -i 's/.*LogLevel.*/LogLevel VERBOSE/' "$SSHDCONF"
  sed -i 's/.*Banner.*/Banner \/etc\/issue.net/' "$SSHDCONF"
  sed -i 's/.*Subsystem.*sftp.*/Subsystem sftp internal-sftp/' "$SSHDCONF"
  sed -i 's/^#.*Compression.*/Compression no/' "$SSHDCONF"
  sed -i "s/.*Port.*/Port $SSH_PORT/" "$SSHDCONF"

  echo "" >> "$SSHDCONF"

  _sshd_set_option "LogLevel" "VERBOSE" "$SSHDCONF"
  _sshd_set_option "PrintLastLog" "yes" "$SSHDCONF"
  _sshd_set_option "IgnoreUserKnownHosts" "yes" "$SSHDCONF"
  _sshd_set_option "PermitEmptyPasswords" "no" "$SSHDCONF"
  _sshd_set_option "MaxAuthTries" "3" "$SSHDCONF"
  _sshd_set_option "ClientAliveInterval" "200" "$SSHDCONF"
  _sshd_set_option "ClientAliveCountMax" "3" "$SSHDCONF"
  _sshd_set_option "PermitUserEnvironment" "no" "$SSHDCONF"
  _sshd_set_option "KexAlgorithms" "curve25519-sha256@libssh.org,ecdh-sha2-nistp521,ecdh-sha2-nistp384,ecdh-sha2-nistp256,diffie-hellman-group-exchange-sha256" "$SSHDCONF"
  _sshd_set_option "Ciphers" "chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr" "$SSHDCONF"
  _sshd_set_option "Macs" "hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256" "$SSHDCONF"
  _sshd_set_option "MaxSessions" "3" "$SSHDCONF"
  _sshd_set_option "UseDNS" "no" "$SSHDCONF"
  _sshd_set_option "StrictModes" "yes" "$SSHDCONF"
  _sshd_set_option "MaxStartups" "10:30:60" "$SSHDCONF"
  _sshd_set_option "HostbasedAuthentication" "no" "$SSHDCONF"
  _sshd_set_option "KerberosAuthentication" "no" "$SSHDCONF"
  _sshd_set_option "GSSAPIAuthentication" "no" "$SSHDCONF"
  _sshd_set_option "RekeyLimit" "512M 1h" "$SSHDCONF"
  _sshd_set_option "AllowTcpForwarding" "no" "$SSHDCONF"
  _sshd_set_option "AllowAgentForwarding" "no" "$SSHDCONF"
  _sshd_set_option "TCPKeepAlive" "no" "$SSHDCONF"
  _sshd_set_option "HostKeyAlgorithms" "ssh-ed25519,rsa-sha2-512,rsa-sha2-256" "$SSHDCONF"

  if ! grep -q "^AllowGroups" "$SSHDCONF" 2> /dev/null; then
    local ALLOW_GROUPS="$SSH_GRPS"
    if [[ -n "${ADMIN_SSH_GROUP:-}" ]]; then
      ALLOW_GROUPS="$ALLOW_GROUPS $ADMIN_SSH_GROUP"
    fi
    echo "AllowGroups $ALLOW_GROUPS" >> "$SSHDCONF"
  fi

  _sshd_set_option "PubkeyAuthentication" "yes" "$SSHDCONF"

  local KEY_USER="${SSH_PUBKEY_USER:-${ADMIN_USER:-}}"

  if [[ -n "$KEY_USER" ]] && [[ -n "$SSH_PUBKEY" || -n "${SSH_GITHUB_USERS:-}" ]]; then
    local USER_HOME
    USER_HOME="$(getent passwd "$KEY_USER" | cut -d: -f6)"

    if [[ -n "$USER_HOME" && ( -L "${USER_HOME}/.ssh" || -L "${USER_HOME}/.ssh/authorized_keys" ) ]]; then
      echo "Warning: ${USER_HOME}/.ssh or authorized_keys is a symlink, skipping key deployment."
    elif [[ -n "$USER_HOME" ]]; then
      local SSH_DIR="${USER_HOME}/.ssh"
      local AUTH_KEYS="${SSH_DIR}/authorized_keys"

      mkdir -p "$SSH_DIR"
      chmod 0700 "$SSH_DIR"

      if [[ -n "$SSH_PUBKEY" ]]; then
        if ! grep -qF "$SSH_PUBKEY" "$AUTH_KEYS" 2>/dev/null; then
          echo "$SSH_PUBKEY" >> "$AUTH_KEYS"
        fi
      fi

      if [[ -n "${SSH_GITHUB_USERS:-}" ]]; then
        for gh_user in $SSH_GITHUB_USERS; do
          if [[ ! "$gh_user" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            echo "Warning: invalid GitHub username '$gh_user', skipping."
            continue
          fi

          local gh_keys=""
          if command -v curl >/dev/null 2>&1; then
            gh_keys="$(curl -fsSL --connect-timeout 10 "https://github.com/${gh_user}.keys" 2>/dev/null)" || true
          elif command -v wget >/dev/null 2>&1; then
            gh_keys="$(wget -qO- --timeout=10 "https://github.com/${gh_user}.keys" 2>/dev/null)" || true
          else
            echo "Warning: neither curl nor wget available, cannot fetch GitHub keys."
            break
          fi

          if [[ -n "$gh_keys" ]]; then
            while IFS= read -r key; do
              if [[ -n "$key" ]] && ! grep -qF "$key" "$AUTH_KEYS" 2>/dev/null; then
                echo "$key" >> "$AUTH_KEYS"
              fi
            done <<< "$gh_keys"
            echo "Fetched SSH keys for GitHub user: $gh_user"
          else
            echo "Warning: no keys found for GitHub user $gh_user"
          fi
        done
      fi

      if [[ -f "$AUTH_KEYS" ]]; then
        chmod 0600 "$AUTH_KEYS"
        chown -R "$KEY_USER":"$(id -gn "$KEY_USER")" "$SSH_DIR"
        echo "SSH keys deployed for $KEY_USER."
      else
        echo "Warning: no SSH keys were deployed for $KEY_USER."
      fi
    else
      echo "Warning: user $KEY_USER not found, skipping key deployment."
    fi
  fi

  if [[ "${LOCKOUT_CHECK:-Y}" != "Y" ]] || _lockout_key_access_available; then
    _sshd_set_option "PasswordAuthentication" "no" "$SSHDCONF"
    _sshd_set_option "KbdInteractiveAuthentication" "no" "$SSHDCONF"
  else
    echo "Warning: no account allowed to log in over SSH has a public key in authorized_keys."
    echo "Password authentication is left unchanged to prevent a lockout."
    echo "Deploy a key with SSH_PUBKEY or SSH_GITHUB_USERS and run the script again."
  fi

  cp "$SSHDCONF" "/etc/ssh/sshd_config.$(date +%y%m%d)"
  grep -vE '#|^$' "/etc/ssh/sshd_config.$(date +%y%m%d)" | sort | uniq > "$SSHDCONF"
  rm "/etc/ssh/sshd_config.$(date +%y%m%d)"

  chown root:root "$SSHDCONF"
  chmod 0600 "$SSHDCONF"

  local SSH_SVC="ssh.service"
  if [[ "$DISTRO" == "debian" ]]; then
    SSH_SVC="sshd.service"
  fi

  if sshd -t; then
    systemctl restart "$SSH_SVC"
  else
    echo "ERROR: the new OpenSSH configuration is invalid."
    echo "Restoring $SSHDFILE and leaving the running daemon untouched."
    cp "$SSHD_BACKUP" "$SSHDFILE"
    if [[ "$SSHDCONF" != "$SSHDFILE" ]]; then
      rm -f "$SSHDCONF"
    fi
  fi

  rm -f "$SSHD_BACKUP"

  if [[ $VERBOSE == "Y" ]]; then
    systemctl status "$SSH_SVC" --no-pager
    echo
  fi

  ((SCRIPT_COUNT++))
}

function f_sshconfig {
  echo "[$SCRIPT_COUNT] $SSHFILE"

  cp "$SSHFILE" "/etc/ssh/ssh_config.$(date +%y%m%d)"

  if ! grep -q "^\s.*HashKnownHosts" "$SSHFILE" 2> /dev/null; then
    sed -i '/HashKnownHosts/d' "$SSHFILE"
    echo "    HashKnownHosts yes" >> "$SSHFILE"
  fi

  sed -i 's/#.*Ciphers .*/    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr/g' "$SSHFILE"
  sed -i 's/#.*MACs .*/    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256/' "$SSHFILE"
}
