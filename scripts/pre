# shellcheck disable=2034

function f_pre {
  SCRIPT_COUNT="0"
  ((SCRIPT_COUNT++))

  export TERM=linux
  export DEBIAN_FRONTEND=noninteractive

  # DPkg::Lock::Timeout waits for a concurrent apt/dpkg (e.g. cloud-init or
  # unattended-upgrades on first boot) instead of failing immediately.
  if [[ $VERBOSE == "Y" ]]; then
    APTFLAGS='--assume-yes -o DPkg::Lock::Timeout=300'
  else
    APTFLAGS='-qq --assume-yes -o DPkg::Lock::Timeout=300'
  fi

  APT="apt-get $APTFLAGS"

  readonly APTFLAGS
  readonly APT

  if [[ $CHANGEME == "" ]]; then
    echo "Please read the code. Exiting."
    echo
    exit 1
  fi

  if [ "$EUID" -ne 0 ]; then
    echo "Not root or not enough privileges. Exiting."
    echo
    exit 1
  fi

  if [[ "$DISTRO" != "ubuntu" && "$DISTRO" != "debian" ]]; then
    echo "Ubuntu or Debian required. Exiting."
    echo
    exit 1
  fi
}
